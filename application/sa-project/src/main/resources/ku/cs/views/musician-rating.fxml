<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ku.cs.controller.MusicianRatingController">
   <children>
      <HBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" VBox.vgrow="NEVER">
         <children>
            <Label text="Rating">
               <font>
                  <Font name="System Bold" size="28.0" />
               </font></Label>
            <Pane HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#onBackButtonClick" styleClass="button-green" stylesheets="@../themes/default.css" text="Back" HBox.hgrow="ALWAYS">
               <font>
                  <Font size="18.0" />
               </font></Button>
         </children></HBox>
      <ScrollPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308">
        <content>
          <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="200.0" prefWidth="200.0">
               <children>
                  <VBox fx:id="musicianListVBox">
                     <children>
                        <HBox>
                           <children>
                              <Label fx:id="MusicianNameLabel" text="musicain name">
                                 <font>
                                    <Font size="20.0" />
                                 </font>
                              </Label>
                              <Button mnemonicParsing="false" text="like" />
                              <Button mnemonicParsing="false" text="unlike" />
                           </children>
                        </HBox>
                     </children></VBox>
               </children></AnchorPane>
        </content>
      </ScrollPane>
   </children>
</VBox>
